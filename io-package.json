{
  "common": {
    "name": "elevenlabs-tts",
    "version": "0.1.0",
    "news": {
      "0.1.0": {
        "en": "initial release",
        "de": "Erstveröffentlichung"
      }
    },
    "title": "ElevenLabs TTS",
    "titleLang": {
      "en": "ElevenLabs TTS",
      "de": "ElevenLabs TTS"
    },
    "desc": {
      "en": "Reads text from a datapoint and saves an MP3 file generated by ElevenLabs",
      "de": "Liest Text aus einem Datenpunkt und speichert eine von ElevenLabs erzeugte MP3-Datei"
    },
    "authors": [
      "SteinchenIO <git@felz.de>"
    ],
    "keywords": [
      "elevenlabs",
      "tts",
      "text-to-speech",
      "mp3"
    ],
    "licenseInformation": {
      "type": "free",
      "license": "MIT"
    },
    "platform": "Javascript/Node.js",
    "icon": "elevenlabs-tts.png",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/SteinchenIO/ioBroker.elevenlabs-tts/main/admin/elevenlabs-tts.png",
    "readme": "https://github.com/SteinchenIO/ioBroker.elevenlabs-tts/blob/main/README.md",
    "loglevel": "info",
    "mode": "daemon",
    "type": "multimedia",
    "compact": true,
    "connectionType": "cloud",
    "dataSource": "push",
    "adminUI": {
      "config": "json"
    },
    "supportedMessages": {
      "custom": false
    },
    "tier": 3,
    "dependencies": [
      {
        "js-controller": ">=5.0.19"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=6.0.0"
      }
    ]
  },
  "native": {
    "apiKey": "",
    "voiceId": "21m00Tcm4TlvDq8ikWAM",
    "modelId": "eleven_multilingual_v2",
    "languageCode": "",
    "outputFormat": "mp3_44100_128",
    "stability": 50,
    "similarityBoost": 75,
    "textStateId": "",
    "triggerOnlyAck": false,
    "outputPath": "/opt/iobroker/iobroker-data/elevenlabs-tts",
    "fileNameMode": "timestamp",
    "fixedFileName": "speech",
    "maxTextLength": 5000,
    "requestTimeoutSec": 30
  },
  "protectedNative": [
    "apiKey"
  ],
  "encryptedNative": [
    "apiKey"
  ],
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "API reachable",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "speak",
      "type": "state",
      "common": {
        "role": "text",
        "name": "Text to convert (alternative to configured datapoint)",
        "type": "string",
        "read": true,
        "write": true,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "lastFile",
      "type": "state",
      "common": {
        "role": "text",
        "name": "Full path of the last generated MP3 file",
        "type": "string",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "lastText",
      "type": "state",
      "common": {
        "role": "text",
        "name": "Last converted text",
        "type": "string",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "lastError",
      "type": "state",
      "common": {
        "role": "text",
        "name": "Last error message",
        "type": "string",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "processing",
      "type": "state",
      "common": {
        "role": "indicator.working",
        "name": "Conversion in progress",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
}
